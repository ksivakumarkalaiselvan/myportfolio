# ---- Server configuration (copy to .env and edit, or set these as Render env vars) ----

# Admin credentials for the easter-egg portal (footer year -> 5 clicks)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-before-deploying

# HMAC key used to sign session tokens. MUST be changed in production.
# Render can generate one for you with:  generateValue: true  in render.yaml
SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in milliseconds (default 8 hours)
SESSION_TTL_MS=28800000

# Where the SQLite file lives.
#   local dev  -> ./data/portfolio.db
#   Render     -> /var/data/portfolio.db  (requires a persistent disk)
DB_PATH=./data/portfolio.db

# Optional: use MongoDB Atlas instead of SQLite (better for Render's free tier,
# where the filesystem is ephemeral and resets on every redeploy).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=portfolio

# Port Render assigns automatically (do not hard-code this)
PORT=3000

# Absolute path to the folder holding index.html
# SITE_DIR=..
